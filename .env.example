# Copie este archivo a .env y ajuste los valores. NO suba .env a Git.
# Use solo letras y números en POSTGRES_PASSWORD (se inserta en una URL).
POSTGRES_DB=catalogo
POSTGRES_USER=catalogo
POSTGRES_PASSWORD=cambiar_por_clave_local

# Genere una clave larga y aleatoria (sin instalar nada en el anfitrión):
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_por_un_valor_aleatorio_largo
APP_PORT=8000
SESSION_HOURS=8
COOKIE_SECURE=0

# Cuentas de EVALUACIÓN (solo demostración; se crean con `create-eval-users`)
EVAL_ADMIN_USER=admin_demo
EVAL_ADMIN_PASSWORD=Admin-Demo-2026!
EVAL_VIEWER_USER=consulta_demo
EVAL_VIEWER_PASSWORD=Consulta-Demo-2026!

# Parcial 3 — roles funcionales de Service Desk (aditivos sobre rol base 'consulta')
EVAL_SOLICITANTE_USER=solicitante_demo
EVAL_SOLICITANTE_PASSWORD=Solicitante-Demo-2026!
EVAL_AGENTE_USER=agente_demo
EVAL_AGENTE_PASSWORD=Agente-Demo-2026!
EVAL_APROBADOR_USER=aprobador_demo
EVAL_APROBADOR_PASSWORD=Aprobador-Demo-2026!
